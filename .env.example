# Vaikora Guard MCP server configuration.
# Copy this file to .env and fill in real values.

# URL of the Vaikora policy engine (the vaikora-llm-gateway HTTP API).
# Default points at a local gateway running on port 8000.
VAIKORA_GATEWAY_URL=http://localhost:8000

# API key for the Vaikora gateway. Required.
# Provision one via your Vaikora admin console or self-hosted gateway admin API.
VAIKORA_API_KEY=

# Optional JWT for end-user attribution on each enforcement call.
# Leave blank if you are not using JWT-scoped policies.
VAIKORA_USER_JWT=

# Timeout (seconds) for outbound calls to the gateway.
VAIKORA_TIMEOUT_SECONDS=10

# Fail-closed (block) when the gateway is unreachable, vs fail-open (allow with
# warning). Defaults to fail-closed for safety.
VAIKORA_FAIL_CLOSED=true

# Log level for the MCP server: DEBUG, INFO, WARNING, ERROR.
VAIKORA_LOG_LEVEL=INFO
